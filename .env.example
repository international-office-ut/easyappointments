#--------------------------------------------------------------------
# Easy!Appointments environment (CI4)
#--------------------------------------------------------------------
# Copy to `.env` and edit per deployment. Only the ACTIVE rows are read;
# commented rows fall back to the class defaults (app/Config/*.php), which
# already carry the app and schema facts of this fork (ea_ prefix, the
# utf8 charset of the CI3-era schema, the CI3-named locale dictionaries).
#
# A minimal deployment only sets the three deployment facts below:
# database credentials, the public base URL, the office timezone.

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# Database
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = easyappointments
database.default.username = root
database.default.password = root

#--------------------------------------------------------------------
# App identity
#--------------------------------------------------------------------

app.baseURL = 'https://appointment.example.org'

# Required: CI4 overrides the php.ini date.timezone at boot with this value
# (system/CodeIgniter.php), so the fleet of date() calls in the booking flow
# runs this timezone regardless of the php.ini setting.
app.appTimezone = 'Europe/Berlin'

# For development details instead: CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# Security / cookies / sessions (defaults live in app/Config/*)
#--------------------------------------------------------------------

# cookie.secure = true
# cookie.httponly = true
# cookie.samesite = Lax

# Security.tokenName = csrfToken
# Security.cookieName = csrfCookie
# Security.expires = 7200
# Security.regenerate = false

# session.cookieName = ea_session
# session.expiration = 7200
# session.savePath = 'writable/session'
# session.matchIP = true

# Logging.threshold = 4 (production default) | 9 (development details)

#--------------------------------------------------------------------
# Easy!Appointments deployment values (defaults live in the Deployment config)
#--------------------------------------------------------------------
# Booleans accept: 1/0 (or true/false, yes/no).

# --- Captcha / install guard ---
# DEBUG_MODE = 0
# ALTCHA_HMAC_KEY =
# INSTALL_ALLOWED_RANGES =

# --- Email (the office mail relay) ---
# EMAIL_PROTOCOL = smtp
# SMTP_HOST =
# SMTP_PORT = 587
# SMTP_AUTH = 0
# SMTP_USER =
# SMTP_PASS =
# SMTP_CRYPTO = tls

# --- Shibboleth SSO ---
# SHIB_ENABLED = 0
# SHIB_ATTR_EMAIL = mail
# SHIB_ATTR_NAME = displayName
# SHIB_PASSWORD_LOGIN = 1
# SHIB_LOGIN_PATH = /Shibboleth.sso/Login
# SHIB_LOGOUT_PATH = /Shibboleth.sso/Logout

# --- Provider calendar feed ---
# ICAL_FEED_RANGE_PAST = 30
# ICAL_FEED_RANGE_FUTURE = 365
# ICAL_FEED_INCLUDE_CUSTOMER = 1

# --- Release identity ---
# EA_VERSION = 2.0.0
# EA_RELEASE_LABEL =
# EA_CACHE_BUSTING_TOKEN = ZW007
