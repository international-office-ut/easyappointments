#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# Easy!Appointments (shared deployment values — no server secrets in
# tracked sources; copy this file to .env and set values)
#--------------------------------------------------------------------
# DEBUG_MODE = 0
# ALTCHA_HMAC_KEY =
# INSTALL_ALLOWED_RANGES =

# --- Database (CI4 groups) ---
# database.default.hostname = localhost
# database.default.database = easyappointments
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.charset = utf8
# database.default.DBCollat = utf8_general_ci

# The table prefix must match the CI3 deployment ('ea_') for parity.
# database.default.DBPrefix = 'ea_'
database.default.DBPrefix = 'ea_'

# --- Session / cookies (CI4) ---
# session.cookieName = ea_session
# session.expiration = 7200
# session.savePath = 'writable/session'
# session.matchIP = true
# session.timeToUpdate = 300
# session.regenerateDestroy = false
# cookie.secure = true
# cookie.httponly = true
# cookie.samesite = Lax

# --- CSRF (CI4) ---
# Security.tokenName = csrfToken
# Security.cookieName = csrfCookie
# Security.expires = 7200
# Security.regenerate = false

# --- Logging ---
# Logging.log.level = 'error'
# Logging.log.path = 'storage/logs/'

# --- Deployment (same names as the CI3 config.php) ---
# EMAIL_PROTOCOL = smtp
# SMTP_HOST =
# SMTP_PORT = 587
# SMTP_AUTH = 0
# SMTP_USER =
# SMTP_PASS =
# SMTP_CRYPTO = tls
# SHIB_ENABLED = 0
# SHIB_ATTR_EMAIL = mail
# SHIB_ATTR_NAME = displayName
# SHIB_PASSWORD_LOGIN = 1
# SHIB_LOGIN_PATH = /Shibboleth.sso/Login
# SHIB_LOGOUT_PATH = /Shibboleth.sso/Logout
# ICAL_FEED_RANGE_PAST = 30
# ICAL_FEED_RANGE_FUTURE = 365
# ICAL_FEED_INCLUDE_CUSTOMER = 1
# EA_VERSION = 2.0.0
# EA_RELEASE_LABEL =
# EA_CACHE_BUSTING_TOKEN = ZW007

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# database.default.hostname = localhost
# database.default.database = ci4
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4
