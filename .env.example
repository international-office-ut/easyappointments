#--------------------------------------------------------------------
# Easy!Appointments environment (CI4)
#--------------------------------------------------------------------
# Copy to `.env` and edit per deployment. Only the ACTIVE rows are read;
# commented rows leave the shipped defaults (app/Config/*.php) in effect.
#
# Required rows on every deployment (do not ship without): database block
# incl. DBPrefix, charset/DBCollat (CI3 schema parity), app.defaultLocale
# (CI3-named locales), app.appTimezone (CI4 overrides php.ini), baseURL.

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# Database — REQUIRED (the schema is CI3-era and must keep the ea_ prefix)
#--------------------------------------------------------------------

# NOTE: the CI3 stack stores every table with the 'ea_' prefix (ea_users etc.);
# CI4 keeps identical naming via this prefix, so the model table() calls hit
# the same underlying tables.
database.default.hostname = localhost
database.default.database = easyappointments
database.default.username = root
database.default.password = root
database.default.DBDriver = MySQLi
# Required: the CI3-era schema is utf8/utf8_general_ci while the CI4 class
# defaults are utf8mb4 — leaving these commented crashes the connection.
database.default.charset = utf8
database.default.DBCollat = utf8_general_ci
database.default.DBPrefix = 'ea_'

#--------------------------------------------------------------------
# App — REQUIRED identity rows (browser URLs, languages, timezone)
#--------------------------------------------------------------------

app.baseURL = 'https://appointment.example.org/'
app.indexPage = 'index.php'

# The EA locales are the CI3 directory names (english/german); the CI4
# skeleton default 'en' has no EA dictionary beneath it.
app.defaultLocale = 'english'

# Required: CI4 overrides the php.ini date.timezone at boot with this value
# (system/CodeIgniter.php date_default_timezone_set). The booking and the
# notifications write schedule data with PHP date(); set it to your office.
app.appTimezone = 'Europe/Berlin'

#--------------------------------------------------------------------
# Security / cookies (CI4 filters keep prod defaults)
#--------------------------------------------------------------------

# cookie.secure = true            # prod keeps TLS posture — do not relax
# cookie.httponly = true
# cookie.samesite = Lax

# Security.tokenName = csrfToken
# Security.cookieName = csrfCookie
# Security.expires = 7200
# Security.regenerate = false

# session.cookieName = ea_session
# session.expiration = 7200
# session.savePath = 'writable/session'
# session.matchIP = true
# session.timeToUpdate = 300
# session.regenerateDestroy = false

#--------------------------------------------------------------------
# Logging (the file handler lives in app/Config/Logger.php → storage/logs)
#--------------------------------------------------------------------

# Logging.threshold = 4 (production default) | 9 (development details)

#--------------------------------------------------------------------
# Easy!Appointments deployment values (same names as the old config.php)
#--------------------------------------------------------------------

# Booleans accept: 1/0 (or true/false, yes/no).
# DEBUG_MODE = 0
# ALTCHA_HMAC_KEY =
# INSTALL_ALLOWED_RANGES =

# --- Email (the office mail relay) ---
# EMAIL_PROTOCOL = smtp
# SMTP_HOST =
# SMTP_PORT = 587
# SMTP_AUTH = 0
# SMTP_USER =
# SMTP_PASS =
# SMTP_CRYPTO = tls

# --- Shibboleth SSO ---
# SHIB_ENABLED = 0
# SHIB_ATTR_EMAIL = mail
# SHIB_ATTR_NAME = displayName
# SHIB_PASSWORD_LOGIN = 1
# SHIB_LOGIN_PATH = /Shibboleth.sso/Login
# SHIB_LOGOUT_PATH = /Shibboleth.sso/Logout

# --- Provider calendar feed ---
# ICAL_FEED_RANGE_PAST = 30
# ICAL_FEED_RANGE_FUTURE = 365
# ICAL_FEED_INCLUDE_CUSTOMER = 1

# --- Release identity ---
# EA_VERSION = 2.0.0
# EA_RELEASE_LABEL =
# EA_CACHE_BUSTING_TOKEN = ZW007
